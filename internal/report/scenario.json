{
  "schema": "readmit-test/v1",
  "name": "Synthetic SIU reschedule updates the original appointment",
  "input": {"case": "reproducer", "messages": ["s0001-e000001", "s0001-e000002"]},
  "target": "target.json",
  "setup": {
    "initial_state": "empty-ledger",
    "reset_instructions": "Stop the prior listener. Start a fresh readmit listen session in the declared mode with a new receiver output and observation.json, using --max-messages 2. Wait for Listening before running this spec. Require an empty initial ledger and no processed occurrences. Never reuse output or observation files."
  },
  "observation": {"boundary": "appointment-ledger", "path": "observation.json"},
  "assertions": [
    {"id": "one-appointment", "operator": "ledger_count", "expected": {"count": 1}},
    {
      "id": "original-record-moved", "operator": "ledger_equals",
      "expected": {"records": [{
        "record_id": "r000001",
        "patient_id": {"value": "SYNTH-0000000000000000", "namespace": "READMIT", "universal_id": "", "universal_id_type": ""},
        "placer_id": {"value": "PLACER-0E5721FF57390BF4", "namespace": "READMIT", "universal_id": "", "universal_id_type": ""},
        "filler_id": {"value": "FILLER-88EE33C89BA69B57", "namespace": "READMIT", "universal_id": "", "universal_id_type": ""},
        "appointment_start": "20260103120000+0000"
      }]}
    },
    {"id": "booking-ack", "operator": "ack_field_equals", "message": "s0001-e000001", "selector": "MSA-1", "expected": {"field": {"state": "present", "text": "AA"}}},
    {"id": "reschedule-ack", "operator": "ack_field_equals", "message": "s0001-e000002", "selector": "MSA-1", "expected": {"field": {"state": "present", "text": "AA"}}}
  ]
}
