# text controls line endings; diff keeps source reviewable even with a stray NUL.
*.go text eol=lf diff
*.ts text diff
*.tsx text diff
*.md text eol=lf diff
*.json text diff
*.py text diff
*.yml text eol=lf diff

# Raw evidence retains byte-preserving binary attributes.
testdata/fixtures/* binary
testdata/verification/corpus/*.hl7 binary
testdata/verification/corpus/*.mllp binary
testdata/verification/endpoint/*.hl7 binary

# Sealed native acceptance evidence must survive Windows checkout byte-for-byte.
testdata/acceptance/native-109/** -text
testdata/engineexport/** -text
testdata/lab-evidence/** -text

# Profile/lab qualification matrices bind these files by their exact bytes.
testdata/profile-evaluation/** -text
testdata/profile-evaluation/**/*.hl7 binary
testdata/integration-lab/qualification/** -text

# Generation requests pin the owned profiles and pack by their exact bytes, and
# the golden messages are CR-terminated evidence.
testdata/casegen/** -text
testdata/casegen/golden/*.hl7 binary
